{
  "name": "finalcircle",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @finalcircle/client",
    "build": "npm run build -w @finalcircle/client",
    "build:server": "tsx tools/build-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "tsx tools/verify.ts",
    "import-cards": "tsx tools/import-cards.ts",
    "coverage": "tsx tools/card-coverage.ts",
    "fuzz": "tsx tools/fuzz.ts",
    "golden": "tsx tools/golden.ts",
    "arena": "tsx tools/ai-arena.ts",
    "bench": "tsx tools/bench.ts",
    "server": "npm run start -w @finalcircle/server"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "playwright": "~1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
